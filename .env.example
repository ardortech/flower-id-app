# Copy to .env for local development. Never commit real keys.
# `npm run dev` turns on MOCK_IDENTIFY=1 by default, so no keys are needed for the mock.
MOCK_IDENTIFY=1
# Set to low to see the 「可能是這幾種」 screen (top match under 50%).
# MOCK_IDENTIFY=low
# Set to no_plant to see the 「看不太清楚」 screen.
# MOCK_IDENTIFY=no_plant
# PLANTNET_API_KEY=
# ANTHROPIC_API_KEY=
